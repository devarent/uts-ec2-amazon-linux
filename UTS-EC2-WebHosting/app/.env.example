# ------------------------------------------------------------------
# App runtime (server-only, aman untuk produksi)
# ------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Wajib untuk metadata, sitemap, dan canonical URL.
# Ganti ke domain HTTPS kamu, TANPA trailing slash.
NEXT_PUBLIC_SITE_URL=https://app.example.com

APP_VERSION=1.0.0

# ------------------------------------------------------------------
# Database (untuk `npm run dev` / app di host).
# Di Docker Compose, DATABASE_URL di-set otomatis ke service `db`.
# Jalankan dulu: docker compose up -d db
# ------------------------------------------------------------------
DATABASE_URL=postgres://ec2lab:ganti-password-kuat@127.0.0.1:5433/ec2lab
# Buat health check mengembalikan 503 bila database down (dipakai produksi).
REQUIRE_DB=false
# Token untuk DELETE /api/guestbook.
ADMIN_TOKEN=ganti-token-admin-acak

# ------------------------------------------------------------------
# AI (opsional). Tanpa key, /api/ai memakai knowledge base lokal.
# ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
