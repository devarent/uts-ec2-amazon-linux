# ------------------------------------------------------------------
# Root env untuk docker compose di EC2.
# File ini TIDAK boleh di-commit. chmod 600 .env
# ------------------------------------------------------------------

# Domain yang A record-nya sudah mengarah ke Elastic IP.
DOMAIN=app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Image yang dipakai deploy. Pipeline menimpanya dengan tag sha.
APP_IMAGE=ghcr.io/owner/repo:latest

# ------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------
# Pilih salah satu opsi:
#
# Opsi 1: Docker PostgreSQL (default)
#   - POSTGRES_* variables digunakan
#   - Database berjalan di container db
#   - DATABASE_URL dibiarkan kosong
#   - DATABASE_SSL=false
#
# Opsi 2: AWS RDS PostgreSQL (managed)
#   - DATABASE_URL diisi dengan connection string RDS
#   - DATABASE_SSL=true
#   - POSTGRES_* variables diabaikan
#   - Lihat docs/11-rds-setup.md untuk setup
#
# Untuk RDS, dapatkan connection string dari:
#   cd terraform && terraform output rds_connection_string
# ------------------------------------------------------------------

# Docker PostgreSQL (hanya untuk Opsi 1)
POSTGRES_DB=ec2lab
POSTGRES_USER=ec2lab
POSTGRES_PASSWORD=ganti-password-kuat

# Database URL (hanya untuk Opsi 2: RDS)
# Contoh: postgresql://user:password@host.rds.amazonaws.com:5432/dbname
DATABASE_URL=
DATABASE_SSL=false

# Token untuk DELETE /api/guestbook (header x-admin-token).
# Kosongkan untuk menonaktifkan delete.
ADMIN_TOKEN=ganti-token-admin-acak

# ------------------------------------------------------------------
# Runtime app
# ------------------------------------------------------------------
APP_VERSION=1.0.0
NODE_ENV=production

# AI opsional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
